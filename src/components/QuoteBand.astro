---
import Arrow from './Arrow.astro';
interface Props {
  title?: string;
}
const { title = 'HAVE A DRAWING?\nLET’S TALK PARTS.' } = Astro.props;
---

<section class="quote-band">
  <div class="container quote-inner">
    <div>
      <p class="eyebrow">DRAWING · MATERIAL · ANNUAL REQUIREMENT</p>
      <h2>{title.replace(/\\n/g, '\n')}</h2>
    </div>
    <div>
      <p>
        Share your drawing and estimated annual requirement. Small quantities, varied components,
        and a supply relationship built around your production needs.
      </p>
      <a class="button button-dark" href="/request-a-quote/">
        Request a quotation <Arrow />
      </a>
    </div>
  </div>
</section>
