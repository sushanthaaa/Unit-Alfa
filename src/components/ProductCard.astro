---
import type { Product } from '../data/products';
import Arrow from './Arrow.astro';
interface Props {
  product: Product;
  compact?: boolean;
}
const { product: p, compact = false } = Astro.props;
---

<article
  class:list={['product-card', { compact }]}
  id={p.id}
  data-category={p.category}
  data-reveal
>
  <div class="product-figure">
    <a
      href={`/images/${p.image}.webp`}
      data-lightbox
      data-caption={`${p.name} · ${p.photoPage ? 'Unit Alfa company profile, page ' + p.photoPage : 'Unit Alfa / Weldtables'}`}
      aria-label={`Enlarge ${p.name} photograph`}
    >
      <img
        src={`/images/${p.image}.webp`}
        width={p.width}
        height={p.height}
        alt={p.alt}
        loading="lazy"
        decoding="async"
      />
      <span class="zoom-label">
        Inspect photograph <span aria-hidden="true">+</span>
      </span>
    </a>
  </div>
  <div class="product-info">
    <p class="eyebrow">{p.category}</p>
    <h3>
      <a href={`/products/${p.id}/`}>{p.name}</a>
    </h3>
    {!compact && <p>{p.description}</p>}
    <a class="text-link" href={`/products/${p.id}/`}>
      View component details <Arrow />
    </a>
  </div>
</article>
