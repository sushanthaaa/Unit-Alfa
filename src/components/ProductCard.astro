---
import type { Product } from '../data/products';
import Arrow from './Arrow.astro';
interface Props {
  product: Product;
  compact?: boolean;
}
const { product: p, compact = false } = Astro.props;
---

<article
  class:list={['product-card', { compact }]}
  id={p.id}
  data-category={p.category}
  data-reveal
>
  <div class="product-figure">
    <a
      href={`/images/${p.image}.webp`}
      data-lightbox
      data-caption={`${p.name} — ${p.generated ? 'Generated illustrative example. Not a Unit Alfa production sample.' : p.id === 'custom-fabrication' ? 'Unit Alfa / Weldtables published assembly photograph.' : 'Unit Alfa published product photograph.'}`}
      aria-label={`Enlarge ${p.name} image`}
    >
      <img
        src={`/images/${p.image}.webp`}
        width={p.width}
        height={p.height}
        alt={p.alt}
        loading="lazy"
        decoding="async"
      />
      <span class="zoom-label">
        View image <span aria-hidden="true">+</span>
      </span>
    </a>
    <span class:list={['photo-type', { 'is-illustration': p.generated }]}>
      {p.generated
        ? 'Illustrative example · generated'
        : p.id === 'custom-fabrication'
          ? 'Weldtables assembly photograph'
          : 'Unit Alfa product photograph'}
    </span>
  </div>
  <div class="product-info">
    <p class="eyebrow">{p.category}</p>
    <h3>{p.name}</h3>
    {!compact && (
      <>
        <p>{p.description}</p>
        <div class="product-spec">
          <span>INCLUDE WITH YOUR ENQUIRY</span>
          {p.requirements}
        </div>
      </>
    )}
    <a class="text-link" href={`/enquiry/?part=${encodeURIComponent(p.name)}`}>
      Request a quote <Arrow />
    </a>
  </div>
</article>
