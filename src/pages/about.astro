---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Arrow from '../components/Arrow.astro';
import { company } from '../data/company';
---

<Layout
  title="About Unit Alfa — Bommasandra Manufacturer Since 1991"
  description="Established in 1991, Unit Alfa manufactures light and medium pressed components and fabricated assemblies for off-highway equipment in Bengaluru."
>
  <PageIntro
    label="ABOUT / UNIT ALFA"
    title="BOMMASANDRA ROOTS. MANUFACTURING SINCE 1991."
    intro="A manufacturer of pressed components and fabricated assemblies, with a focus on hydraulic excavators and the off-highway industry."
  />
  <section class="container about-story section-bottom">
    <figure class="about-photo" data-reveal>
      <img
        src="/images/profile-factory-profile.webp"
        srcset="/images/profile-factory-profile-640.webp 640w, /images/profile-factory-profile.webp 1157w"
        sizes="(max-width: 800px) 90vw, 45vw"
        width="1157"
        height="1592"
        alt="Blue-clad Unit Alfa premises with trees and a yellow entrance gate in Bommasandra."
        fetchpriority="high"
      />
      <figcaption>Our premises · company-supplied profile</figcaption>
    </figure>
    <div data-reveal>
      <p class="eyebrow">THE COMPANY</p>
      <h2>
        BUILT AROUND
        <br />
        COMPONENT WORK.
      </h2>
      <p>
        Unit Alfa was established in 1991. Our work covers light and medium press components,
        machining, fabrication and assemblies for off-highway equipment.
      </p>
      <p>
        We design and manufacture tools, fixtures and jigs, bringing development and production
        requirements into the same conversation. Assembly and painting support the supply of
        finished components.
      </p>
      <p>
        High variety and low quantities are part of our work. We welcome recurring requirements
        where several different components need to be manufactured and supplied over time.
      </p>
      <dl class="company-facts">
        <div>
          <dt>Established</dt>
          <dd>1991</dd>
        </div>
        <div>
          <dt>Covered premises</dt>
          <dd>16,600 sq ft · own premises</dd>
        </div>
        <div>
          <dt>Proprietor</dt>
          <dd>{company.proprietor}</dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>Bommasandra 4th Phase, Bengaluru</dd>
        </div>
        <div>
          <dt>GSTIN</dt>
          <dd>{company.gstin}</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="dark-section">
    <div class="container split-section">
      <div>
        <p class="eyebrow">CUSTOMER RELATIONSHIPS</p>
        <h2>
          PART OF THE
          <br />
          OFF-HIGHWAY SUPPLY CHAIN.
        </h2>
        <p>
          Our main customers include Kobelco and Komatsu. The work spans individual pressed parts
          and assemblies used in hydraulic excavators.
        </p>
      </div>
      <div class="customer-names">
        <span>KOBELCO</span>
        <span>KOMATSU</span>
        <p>Customer references provided by Unit Alfa.</p>
      </div>
    </div>
  </section>
  <section class="section container split-section">
    <div>
      <p class="eyebrow">DEVELOPMENT EXPERIENCE</p>
      <h2>
        MANY PARTS.
        <br />A PRACTICAL APPROACH.
      </h2>
      <p>
        The company profile records more than 800 parts developed for different customers over time.
        Each new requirement starts with the drawing, material and application.
      </p>
      <a class="text-link" href="/how-we-work/">
        From requirement to production <Arrow />
      </a>
    </div>
    <figure>
      <img
        src="/images/profile-component-range.webp"
        width="892"
        height="669"
        alt="A selection of Unit Alfa manufactured components arranged on a wooden display."
        loading="lazy"
      />
      <figcaption>Examples of component development · company profile</figcaption>
    </figure>
  </section>
  <QuoteBand />
</Layout>
