---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import { company } from '../data/company';
---

<Layout
  title="Request a Quote — Press Components & Assemblies | Unit Alfa"
  description="Send Unit Alfa your component drawings, materials and estimated annual quantities. Submit a manufacturing enquiry and receive a reference for tracking."
>
  <PageIntro
    label="REQUEST A QUOTE"
    title="YOUR DRAWING. OUR STARTING POINT."
    intro="Tell us about the component and your annual requirement. Submit one or several parts together for technical review."
  />
  <section class="container rfq-layout section-bottom">
    <aside class="rfq-aside">
      <p class="eyebrow">A USEFUL START</p>
      <h2>
        PART. MATERIAL.
        <br />
        ANNUAL DEMAND.
      </h2>
      <p>
        Small quantities are welcome. An annual estimate helps us understand the tooling and repeat
        supply requirement; it is not a purchase commitment.
      </p>
      <div class="contact-note">
        <strong>{company.contactName}</strong>
        <span>{company.contactRole}</span>
        <a href={company.phoneHref}>{company.phone}</a>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </aside>
    <div>
      <div id="service-message" class="form-message" role="status">
        Checking online enquiry availability… You can also{' '}
        <a href={`mailto:${company.email}`}>email the team</a>.
      </div>
      <noscript>
        <p class="form-message">
          Online submission requires JavaScript. Email your requirement to{' '}
          <a href={`mailto:${company.email}`}>{company.email}</a> or call{' '}
          <a href={company.phoneHref}>{company.phone}</a>.
        </p>
      </noscript>
      <form id="rfq-form" class="rfq-form" novalidate>
        <ol class="rfq-progress" aria-label="Enquiry steps">
          <li aria-current="step">1 · Contact</li>
          <li>2 · Parts</li>
          <li>3 · Drawings</li>
          <li>4 · Review</li>
        </ol>
        <div class="honeypot" aria-hidden="true">
          <label for="company-website">Leave this field empty</label>
          <input id="company-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <fieldset class="rfq-step" data-step="0">
          <legend tabindex="-1">01 / Company & contact</legend>
          <div class="form-grid">
            <div class="field full">
              <label for="company">Company name *</label>
              <input
                id="company"
                name="company"
                autocomplete="organization"
                required
                minlength="2"
                maxlength="160"
              />
            </div>
            <div class="field">
              <label for="contactName">Your name *</label>
              <input
                id="contactName"
                name="contactName"
                autocomplete="name"
                required
                minlength="2"
                maxlength="100"
              />
            </div>
            <div class="field">
              <label for="email">Email *</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
              />
              <small>Your acknowledgement and private status link go here.</small>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
            </div>
            <div class="field">
              <label for="industry">Target industry</label>
              <select id="industry" name="industry">
                <option value="">Select an industry</option>
                <option>Hydraulic excavators / off-highway</option>
                <option>Automotive components</option>
                <option>Industrial equipment</option>
                <option>Other manufacturing</option>
              </select>
            </div>
          </div>
        </fieldset>
        <fieldset class="rfq-step" data-step="1">
          <legend tabindex="-1">02 / Parts & annual quantities</legend>
          <p class="field-help">
            Add up to 10 part requirements. Material and thickness can be left for discussion if
            your specification is still developing.
          </p>
          <div id="parts-list"></div>
          <button class="small-button" type="button" id="add-part">
            + Add another part
          </button>
        </fieldset>
        <fieldset class="rfq-step" data-step="2">
          <legend tabindex="-1">03 / Drawings & supply needs</legend>
          <div class="form-grid">
            <div class="field">
              <label for="deliveryLocation">Delivery location</label>
              <input
                id="deliveryLocation"
                name="deliveryLocation"
                maxlength="200"
                placeholder="City / plant location"
              />
            </div>
            <div class="field">
              <label for="startDate">Intended start</label>
              <input
                id="startDate"
                name="startDate"
                maxlength="100"
                placeholder="For example, Q1 2027 or to be discussed"
              />
            </div>
            <div class="field full">
              <label for="frequency">Expected release / delivery frequency</label>
              <input
                id="frequency"
                name="frequency"
                maxlength="120"
                placeholder="Monthly, quarterly, as scheduled, or not yet known"
              />
            </div>
            <div class="field full">
              <label for="notes">Additional requirements</label>
              <textarea
                id="notes"
                name="notes"
                maxlength="4000"
                rows="5"
                placeholder="Critical dimensions, weld requirements, inspection records, packaging, tooling or sample availability."
              ></textarea>
            </div>
          </div>
          <div class="upload-zone">
            <label class="field-label" for="drawings">
              Drawing files (optional)
            </label>
            <input
              id="drawings"
              type="file"
              multiple
              accept=".pdf,.step,.stp,.iges,.igs,.dxf,.dwg,.png,.jpg,.jpeg"
              aria-describedby="drawing-help"
            />
            <p id="drawing-help" class="field-help">
              PDF, STEP, IGES, DXF, DWG, PNG or JPEG. Up to 6 files, 20 MB each and 40 MB total.
              Include the part number and revision in each filename. Files upload privately when you
              submit.
            </p>
            <ul id="upload-list" class="upload-list"></ul>
            <p id="upload-feedback" class="form-error" role="status"></p>
          </div>
        </fieldset>
        <fieldset class="rfq-step" data-step="3">
          <legend tabindex="-1">04 / Review your enquiry</legend>
          <p>Check the contact email, quantities and drawing revisions before submitting.</p>
          <div id="rfq-review"></div>
          <label class="check-label" for="consent">
            <input id="consent" name="consent" type="checkbox" required />
            <span>
              I am authorised to share this information for assessment and quotation. I have read
              the{' '}
              <a href="/privacy/" target="_blank" rel="noreferrer">
                privacy and drawing-handling notice
              </a>
              .
            </span>
          </label>
          <p class="form-privacy">
            Submission is a request for review. It is not an order acceptance or an instant
            quotation.
          </p>
        </fieldset>
        <p id="form-error" class="form-error" role="alert" tabindex="-1"></p>
        <p id="submission-progress" class="field-help" role="status" aria-live="polite"></p>
        <div class="form-actions">
          <button class="button button-outline" type="button" id="rfq-back" hidden>
            Back
          </button>
          <button class="button button-dark" type="button" id="rfq-next">
            Continue <Arrow />
          </button>
          <button class="button button-dark" type="submit" id="rfq-submit" hidden disabled>
            Submit enquiry <Arrow />
          </button>
        </div>
      </form>
      <section id="rfq-receipt" class="receipt" hidden tabindex="-1" aria-live="polite">
        <p class="eyebrow">ENQUIRY SAVED</p>
        <h2>
          THANK YOU.
          <br />
          WE HAVE YOUR REQUIREMENT.
        </h2>
        <p>Keep this reference for your discussion with the team.</p>
        <strong id="receipt-reference" class="receipt-reference"></strong>
        <p>
          An acknowledgement has been queued for your email. Your enquiry is saved even if email
          delivery takes longer.
        </p>
        <div class="button-row">
          <a id="receipt-track" class="button button-dark" href="/track-enquiry/">
            View enquiry status <Arrow />
          </a>
          <button class="small-button" id="copy-reference" type="button">
            Copy reference
          </button>
        </div>
        <p id="receipt-feedback" class="field-help" role="status"></p>
      </section>
    </div>
  </section>
  <template id="part-template">
    <section class="part-entry">
      <div class="part-entry-heading">
        <h3>
          Part <span data-part-number></span>
        </h3>
        <button class="remove-part" type="button">
          Remove
        </button>
      </div>
      <div class="form-grid">
        <div class="field full">
          <label data-label="name">Part name / number *</label>
          <input data-field="name" required maxlength="160" />
        </div>
        <div class="field">
          <label data-label="revision">Drawing revision</label>
          <input data-field="revision" maxlength="80" />
        </div>
        <div class="field">
          <label data-label="annualQuantity">Estimated annual quantity *</label>
          <input
            data-field="annualQuantity"
            type="number"
            min="1"
            max="1000000000"
            step="1"
            inputmode="numeric"
            required
          />
          <label class="check-label" data-label="unknown">
            <input data-field="unknown" type="checkbox" />
            <span>Not yet known</span>
          </label>
        </div>
        <div class="field">
          <label data-label="material">Material / grade</label>
          <input data-field="material" maxlength="160" placeholder="As specified on the drawing" />
        </div>
        <div class="field">
          <label data-label="thickness">Thickness</label>
          <input data-field="thickness" maxlength="100" placeholder="Include units, e.g. mm" />
        </div>
        <div class="field full">
          <label data-label="finish">Finish requirements</label>
          <input data-field="finish" maxlength="200" />
        </div>
      </div>
    </section>
  </template>
  <script src="../scripts/enquiry.ts"></script>
</Layout>
