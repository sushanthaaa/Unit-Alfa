---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Arrow from '../components/Arrow.astro';
import { machines, process } from '../data/machines';
---

<Layout
  title="Pressing, Fabrication & Tooling Capabilities | Unit Alfa Bangalore"
  description="Explore Unit Alfa’s laser cutting, pressing, manual and robotic welding, tooling, machining and assembly capabilities in Bommasandra, Bengaluru."
>
  <PageIntro
    label="CAPABILITIES / THE WORKS"
    title="SEVERAL DISCIPLINES. ONE COMPONENT."
    intro="Light and medium press components, fabricated parts and assemblies. Tooling and a practical manufacturing route built around the drawing."
  />
  <section class="container process-layout section-bottom">
    <div class="process-intro" data-reveal>
      <p class="eyebrow">FROM SHEET TO ASSEMBLY</p>
      <h2>
        FOLLOW
        <br />
        THE MATERIAL.
      </h2>
      <p>
        A component may need several operations. Expand each stage to see how the work comes
        together. Its actual route depends on the part.
      </p>
      <figure>
        <img
          src="/images/profile-small-components.webp"
          width="892"
          height="669"
          alt="A variety of small manufactured metal parts photographed for Unit Alfa’s profile."
          loading="lazy"
        />
        <figcaption>Component variety · company profile</figcaption>
      </figure>
    </div>
    <div class="process-steps">
      {process.map((p, i) => (
        <details open={i === 0} data-reveal>
          <summary>
            <span class="step-number">0{i + 1}</span>
            <div>
              <h3>{p.name}</h3>
              <span>{p.sub}</span>
            </div>
            <span class="disclosure-icon" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="step-content">
            <p>{p.text}</p>
            <p class="equipment-label">{p.equipment}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
  <section class="dark-section">
    <div class="container split-section">
      <div data-reveal>
        <p class="eyebrow">TOOLING / FIXTURES / JIGS</p>
        <h2>
          THE WORK STARTS
          <br />
          BEFORE THE FIRST PART.
        </h2>
        <p>
          We design and manufacture tools, fixtures and jigs. The toolroom and machine shop support
          component development, machining and assembly work.
        </p>
        <p>
          Share a drawing or an authorised sample. We’ll discuss the tooling scope and recurring
          supply requirement.
        </p>
        <a class="text-link light-link" href="/products/custom-fabrication/">
          Tooling & modular welding tables <Arrow />
        </a>
      </div>
      <figure data-reveal>
        <img
          src="/images/weldtable-assembly.webp"
          width="720"
          height="720"
          alt="Assembly of a modular welding table from Unit Alfa’s Weldtables range."
          loading="lazy"
        />
        <figcaption>Modular table assembly · Unit Alfa / Weldtables</figcaption>
      </figure>
    </div>
  </section>
  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PLANT & EQUIPMENT</p>
        <h2>A LOOK INSIDE THE WORKS.</h2>
      </div>
      <p class="section-aside">16,600 sq ft of covered area at our own premises in Bommasandra.</p>
    </div>
    <div
      class="table-scroll"
      tabindex="0"
      role="region"
      aria-label="Equipment and capability table"
    >
      <table>
        <caption>Equipment listed in the company-supplied profile</caption>
        <thead>
          <tr>
            <th scope="col">Operation</th>
            <th scope="col">Equipment / rating</th>
            <th scope="col">Application</th>
          </tr>
        </thead>
        <tbody>
          {machines.map((row) => (
            <tr>
              {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="table-note">
      Machine ratings describe equipment. Part size, material thickness and tolerances are reviewed
      for the individual drawing.
    </p>
  </section>
  <section class="specification-section">
    <div class="container split-section">
      <div data-reveal>
        <p class="eyebrow">MATERIALS</p>
        <h2>
          START WITH
          <br />
          THE SPECIFICATION.
        </h2>
        <p>
          Our work is primarily mild steel, with stainless steel for selected requirements. Specify
          the grade and condition, not just “MS” or “SS”.
        </p>
      </div>
      <dl class="material-list">
        <div>
          <dt>HR / CR</dt>
          <dd>Hot-rolled and cold-rolled steel</dd>
        </div>
        <div>
          <dt>HRPO / CRCA</dt>
          <dd>Hot-rolled pickled and oiled; cold-rolled close-annealed steel</dd>
        </div>
        <div>
          <dt>C80</dt>
          <dd>High-carbon steel, assessed against the component requirement</dd>
        </div>
        <div>
          <dt>SS</dt>
          <dd>Stainless steel, with grade specified for review</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="section container split-section">
    <div>
      <p class="eyebrow">WELDING IN PRACTICE</p>
      <h2>SEE THE OPERATION.</h2>
      <p>Company-published footage of automated welding on an excavator battery box.</p>
      <a
        class="text-link"
        href="https://www.youtube.com/watch?v=l7yseQ1enEg"
        target="_blank"
        rel="noreferrer"
      >
        Watch on YouTube <Arrow diagonal />
      </a>
    </div>
    <div class="video-frame">
      <button class="video-load" data-video="l7yseQ1enEg">
        <span class="play-symbol" aria-hidden="true">
          ▶
        </span>
        <strong>Battery box welding</strong>
        <span>Play company video</span>
        <small>YouTube loads only when you choose to play.</small>
      </button>
    </div>
  </section>
  <QuoteBand />
  <script>
    document
      .querySelector<HTMLButtonElement>('[data-video]')
      ?.addEventListener('click', (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${button.dataset.video}?autoplay=1`;
        frame.title = 'Unit Alfa automated battery box welding';
        frame.allow = 'autoplay; fullscreen';
        frame.allowFullscreen = true;
        button.replaceWith(frame);
      });
  </script>
</Layout>
