---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Lightbox from '../components/Lightbox.astro';
import { products } from '../data/products';
---

<Layout
  title="UNIT ALFA — Press Components & Fabricated Assemblies, Bangalore"
  description="Sheet-metal press components, tooling and fabricated assemblies for hydraulic excavators. Unit Alfa has manufactured in Bommasandra, Bengaluru, since 1991."
>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="short-rule"></span> OFF-HIGHWAY COMPONENT MANUFACTURING
      </p>
      <h1>
        <span class="hero-line">
          <span>THE PARTS</span>
        </span>
        <span class="hero-line">
          <span>BEHIND THE</span>
        </span>
        <span class="hero-line hero-line-accent">
          <span>MACHINE.</span>
        </span>
      </h1>
      <p class="hero-intro">
        Pressed components. Fabricated assemblies. Built for hydraulic excavators, from our works in
        Bommasandra, Bengaluru.
      </p>
      <div class="button-row">
        <a class="button button-dark" href="/products/">
          Explore our components <Arrow />
        </a>
        <a class="text-link" href="/request-a-quote/">
          Discuss your drawing <Arrow diagonal />
        </a>
      </div>
      <div class="hero-origin">
        <strong>1991</strong>
        <span>
          MANUFACTURING SINCE
          <br />
          BENGALURU, INDIA
        </span>
      </div>
    </div>
    <div class="hero-visual">
      <div class="image-index">
        <span>01 / FABRICATED ASSEMBLY</span>
        <span>UNIT ALFA</span>
      </div>
      <a
        class="hero-part"
        href="/products/battery-boxes/"
        aria-label="Explore battery box assemblies"
      >
        <img
          src="/images/profile-battery-box.webp"
          srcset="/images/profile-battery-box-640.webp 640w, /images/profile-battery-box.webp 892w"
          sizes="(max-width: 800px) 90vw, 48vw"
          width="892"
          height="669"
          alt="An excavator battery box manufactured by Unit Alfa, with a hinged yellow lid and formed metal body."
          fetchpriority="high"
        />
        <span class="part-tag">
          FORMED · WELDED · ASSEMBLED <Arrow diagonal />
        </span>
      </a>
      <div class="hero-image-caption">
        <span>Battery box assembly</span>
        <span>Manufactured at Unit Alfa</span>
      </div>
      <div class="spec-strip">
        <div>
          <strong>16,600</strong>
          <span>SQ FT COVERED PREMISES</span>
        </div>
        <div>
          <strong>HIGH VARIETY</strong>
          <span>LOW VOLUMES WELCOME</span>
        </div>
      </div>
    </div>
  </section>
  <section class="customer-line">
    <div class="container">
      <span class="eyebrow">CUSTOMERS INCLUDE</span>
      <strong>KOBELCO</strong>
      <strong>KOMATSU</strong>
      <span>Components for the off-highway industry.</span>
    </div>
  </section>
  <section class="section container intro-grid">
    <p class="eyebrow" data-reveal>
      01 / BUILT AROUND THE PART
    </p>
    <h2 data-reveal>
      FROM A PRESSED PART
      <br />
      TO A WORKING ASSEMBLY.
    </h2>
    <div data-reveal>
      <p>
        A bracket locates. A guard protects. A latch closes. We manufacture the components and
        assemblies that fit into your equipment.
      </p>
      <p>
        Tooling, pressing, welding and assembly come together around your drawing and recurring
        supply requirement.
      </p>
      <a class="text-link" href="/capabilities/">
        Explore capabilities & tooling <Arrow />
      </a>
    </div>
  </section>
  <section class="section catalogue-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">02 / COMPONENTS FROM OUR WORKS</p>
          <h2>
            MADE TO FIT.
            <br />
            MADE TO REPEAT.
          </h2>
        </div>
        <a class="text-link" href="/products/">
          Explore the range <Arrow />
        </a>
      </div>
      <div class="featured-products">
        {[products[1], products[2], products[3]].map((product) => (
          <ProductCard product={product} compact />
        ))}
      </div>
    </div>
  </section>
  <section class="dark-section">
    <div class="container home-process">
      <div data-reveal>
        <p class="eyebrow">03 / FROM PLAN TO PRODUCTION</p>
        <h2>
          THE RIGHT INFORMATION.
          <br />
          AT THE WORKSTATION.
        </h2>
        <p>
          Delfoi supports production planning. Our in-house Flowline Information System brings job
          instructions to the shop floor and records production progress.
        </p>
        <a class="text-link light-link" href="/how-we-work/">
          See how we work <Arrow />
        </a>
      </div>
      <ol class="process-index">
        {[
          'Review the drawing',
          'Prepare tooling & route',
          'Plan the work',
          'Manufacture & record progress',
          'Inspect, pack & dispatch',
        ].map((label, i) => (
          <li data-reveal>
            <span>0{i + 1}</span>
            <strong>{label}</strong>
            <Arrow />
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section container home-location">
    <figure data-reveal>
      <img
        src="/images/published-factory-interior.webp"
        width="680"
        height="510"
        alt="Unit Alfa’s published shop-floor photograph with an overhead gantry and equipment."
        loading="lazy"
      />
      <figcaption>Inside the works · company-published photograph</figcaption>
    </figure>
    <div data-reveal>
      <p class="eyebrow">04 / BOMMASANDRA, BENGALURU</p>
      <h2>
        LONG-TERM SUPPLY.
        <br />
        ROOM FOR SMALL QUANTITIES.
      </h2>
      <p>
        Many different components. Modest quantities of each. Our work supports repeat supply for
        light and medium press components, fabrication and assemblies.
      </p>
      <p>
        Share your estimated annual demand. We’ll review the part, tooling and delivery requirements
        together.
      </p>
      <a class="text-link" href="/enquiry/">
        What we can handle <Arrow />
      </a>
    </div>
  </section>
  <QuoteBand />
  <Lightbox />
</Layout>
