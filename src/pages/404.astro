---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
---

<Layout
  title="Page Not Found — Unit Alfa"
  description="Find Unit Alfa’s products, plant capabilities or enquiry page."
  noindex
>
  <section class="container not-found">
    <p class="eyebrow">404 / PAGE NOT FOUND</p>
    <h1>
      LET’S GET YOU
      <br />
      BACK TO THE WORKS.
    </h1>
    <p>
      The address may have changed. Explore our component range or send the team your requirement.
    </p>
    <div class="button-row">
      <a class="button" href="/products/">
        View products <Arrow />
      </a>
      <a class="text-link" href="/">
        Return home <Arrow />
      </a>
    </div>
  </section>
</Layout>
