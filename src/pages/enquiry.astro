---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Arrow from '../components/Arrow.astro';
import { company } from '../data/company';
---

<Layout
  title="Discuss a Manufacturing Requirement | Unit Alfa Bengaluru"
  description="Find out whether Unit Alfa can handle your pressed part or fabricated assembly. High-variety, low-volume and recurring supply enquiries are welcome."
>
  <PageIntro
    label="ENQUIRY / FIND THE RIGHT FIT"
    title="LET’S LOOK AT YOUR COMPONENT."
    intro="A drawing, a material specification and an indication of annual demand give us a useful starting point. You do not need every detail settled to begin a discussion."
  />
  <section class="container enquiry-fit section-bottom">
    <div>
      <p class="eyebrow">WHAT WE HANDLE</p>
      <h2>
        PRESS COMPONENTS.
        <br />
        FABRICATION.
        <br />
        ASSEMBLIES.
      </h2>
      <ul class="requirement-list">
        <li>
          Light and medium components for hydraulic excavators and related industrial applications.
        </li>
        <li>
          Primarily mild steel, with stainless steel and other specified grades reviewed for the
          part.
        </li>
        <li>High variety, including low quantities within recurring supply requirements.</li>
        <li>Tool, fixture and jig development, machining, welding and assembly.</li>
      </ul>
    </div>
    <aside class="enquiry-panel">
      <p class="eyebrow">READY FOR A TECHNICAL REVIEW?</p>
      <h2>
        SEND THE
        <br />
        REQUIREMENT.
      </h2>
      <p>
        Include a drawing or sample reference, estimated annual quantity, material and any important
        fit, finish or delivery needs.
      </p>
      <a class="button button-dark" href="/request-a-quote/">
        Request a quote <Arrow />
      </a>
      <a class="text-link" href="/track-enquiry/">
        Track an existing enquiry <Arrow />
      </a>
      <div class="contact-note">
        <strong>{company.contactName}</strong>
        <span>{company.contactRole}</span>
        <a href={company.phoneHref}>{company.phone}</a>
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </aside>
  </section>
  <section class="specification-section">
    <div class="container split-section">
      <div>
        <p class="eyebrow">SMALL QUANTITIES / REPEAT REQUIREMENTS</p>
        <h2>
          PLAN BY THE YEAR.
          <br />
          DISCUSS THE RELEASES.
        </h2>
      </div>
      <div>
        <p>
          Annual demand helps us understand the tooling and supply requirement. It does not mean
          every component must be delivered in a single batch.
        </p>
        <p>
          If your forecast is still developing, choose “not yet known” in the RFQ and tell us what
          you can. The team will review feasibility before a quotation or supply commitment is made.
        </p>
        <a class="text-link" href="/capabilities/">
          Review manufacturing capabilities <Arrow />
        </a>
      </div>
    </div>
  </section>
</Layout>
