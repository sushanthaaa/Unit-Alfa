# Production origin; never use an arbitrary incoming Host header for email links.
# Preview builds derive their canonical URL from Vercel automatically.
SITE_URL=https://unitalfa.vercel.app
SITE_INDEXABLE=false

# Set true only after the migration, private bucket, sender and staff access are ready.
RFQ_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate independently: openssl rand -hex 32
RFQ_TOKEN_SECRET=
RESEND_API_KEY=
# Must be a sender on a Resend-verified company domain, e.g. Unit Alfa <website@your-verified-domain>
RFQ_FROM_EMAIL=
RFQ_RECIPIENT_EMAIL=gmo@unitalfa.co.in
# Generate independently: openssl rand -hex 32
CRON_SECRET=
